{
  "_doc": "Rules or preferences that contradict the kit. A matching line in a CLAUDE.md, output style, skill or agent is replaced with the kit rule it contradicts (`rule`: its id in kit/rules.json, text read from there); a matching memory file is deleted (backup kept) and its MEMORY.md line removed. Scopes: claude_md, memory, output_style, skill, agent. Patterns are case-insensitive. Keep them specific: a false positive deletes a useful memory.",
  "rules": [
    {
      "id": "prod-without-yes",
      "re": "(\\b(run|do|execute|apply|deploy)\\b[^.\\n]{0,40}\\b(prod|production|vps|live server|live site)\\b[^.\\n]{0,80}\\b(yourself|without asking|just do it|no need to ask|never ask))|never ask me to run|(deploy|push) (straight |directly )?to (prod|production) (without|freely)",
      "rule": "E08",
      "scopes": [
        "claude_md",
        "memory",
        "output_style",
        "skill",
        "agent"
      ]
    },
    {
      "id": "push-main-ok",
      "re": "\\b(push|commit|merge)\\b[^.\\n]{0,30}\\b(directly |straight )?(to|into|on) (main|master)\\b[^.\\n]{0,40}\\b(is fine|is ok|freely|always|without (a )?(pr|review|asking)|no need)",
      "rule": "E07",
      "scopes": [
        "claude_md",
        "memory",
        "output_style",
        "skill",
        "agent"
      ]
    },
    {
      "id": "force-push-ok",
      "re": "force[- ]push(ing)?\\b[^.\\n]{0,40}\\b(is fine|is ok|allowed|freely|when needed|as needed)",
      "rule": "E07",
      "scopes": [
        "claude_md",
        "memory",
        "output_style",
        "skill",
        "agent"
      ]
    },
    {
      "id": "skip-tests",
      "re": "\\b(skip|no need for|don'?t (write|run|bother with)|never write)\\b[^.\\n]{0,15}\\btests?\\b",
      "rule": "E06",
      "scopes": [
        "claude_md",
        "memory",
        "output_style"
      ]
    },
    {
      "id": "edit-vendored-ok",
      "re": "\\b(edit|patch|modify|change)\\b[^.\\n]{0,30}\\b(erpnext|frappe core|frappe/frappe|hrms|india_compliance|node_modules|@medusajs)\\b[^.\\n]{0,30}\\b(directly|is fine|is ok|freely)",
      "rule": "E09",
      "scopes": [
        "claude_md",
        "memory",
        "output_style",
        "skill",
        "agent"
      ]
    },
    {
      "id": "verbose-output",
      "re": "\\b(be verbose|explain (everything|each step) in detail|always give (long|detailed) (answers|explanations)|long(er)? (answers|responses) (are )?(preferred|better))",
      "rule": "C02",
      "scopes": [
        "claude_md",
        "memory",
        "output_style"
      ]
    },
    {
      "id": "copy-db-ok",
      "re": "\\b(copy|sync|dump|restore)\\b[^.\\n]{0,30}\\b(database|db)\\b[^.\\n]{0,40}\\b(between machines|to the cluster|from prod)\\b[^.\\n]{0,40}\\b(without asking|freely|automatically)",
      "rule": "E11",
      "scopes": [
        "claude_md",
        "memory",
        "output_style"
      ]
    },
    {
      "id": "ci-runs-tests",
      "re": "\\b(rely on|wait for|let|leave (it )?to)\\b (the )?(ci|github actions|gh actions|actions workflow|status checks?)\\b[^.\\n]{0,30}\\b(tests?|checks?|gate)",
      "rule": "E12",
      "scopes": [
        "claude_md",
        "memory",
        "output_style",
        "skill",
        "agent"
      ]
    }
  ],
  "settings": {
    "outputStyleConflicts": [
      "Explanatory",
      "Learning"
    ],
    "permissionConflicts": [
      "^git push\\b",
      "^(npm|pnpm|yarn|cargo) publish\\b",
      "^(dropdb|pg_restore)\\b",
      "^bench\\b.*\\b(drop-site|restore|reinstall|migrate)\\b",
      "^kubectl (apply|delete|create|patch|replace|scale|rollout|edit|drain)\\b",
      "^helm\\b",
      "^docker(-buildx)? (push|rm|rmi|system prune|volume rm)\\b",
      "^docker compose\\b.*\\b(up|down|rm)\\b",
      "^offload down\\b",
      "^gh release create\\b",
      "^(vercel|fly deploy|netlify deploy|wrangler deploy|terraform apply|ansible-playbook)\\b"
    ]
  }
}
